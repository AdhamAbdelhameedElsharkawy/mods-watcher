<UserControl x:Class="ModsWatcher.Desktop.Views.ModPackageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ModsWatcher.Desktop.Services"
             Background="{DynamicResource WindowBackground}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="MOD PACKAGE" Style="{DynamicResource InspectorSectionHeaderStyle}"/>
            <TextBlock Text="{Binding ModName}" Style="{DynamicResource ModTitleTextStyle}" FontSize="24"/>
            <TextBlock Text="This mod is the main mod of a package. Members are lightweight — they cannot function independently and are managed entirely here."
                       Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- PACKAGE MEMBERS -->
                <TextBlock Text="PACKAGE MEMBERS" Style="{DynamicResource InspectorSectionHeaderStyle}" Margin="0,0,0,10"/>

                <!-- Empty state -->
                <TextBlock Text="No members yet — add at least one below to turn this mod into a package."
                           Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,20"
                           Visibility="{Binding HasMembers, Converter={StaticResource InverseBoolToVisConverter}}"/>

                <!-- Members list, ordered top to bottom -->
                <ItemsControl ItemsSource="{Binding Members}"
                              Visibility="{Binding HasMembers, Converter={StaticResource BoolToVis}}"
                              Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource HistoryRowStyle}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Button Style="{DynamicResource ReorderButtonStyle}"
                                                Command="{Binding DataContext.MoveMemberUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{DynamicResource TextMuted}" Content="&#xE74A;" FontSize="11"
                                                FontFamily="Segoe MDL2 Assets"/>
                                        <Button Style="{DynamicResource ReorderButtonStyle}"
                                                Command="{Binding DataContext.MoveMemberDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{DynamicResource TextMuted}" Content="&#xE74B;" FontSize="11"
                                                FontFamily="Segoe MDL2 Assets"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Notes}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource ActionIconButtonStyle}"
                                            ToolTip="Remove this member">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="#E57373" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add member section -->
                <TextBlock Text="ADD MEMBER" Style="{DynamicResource InspectorSectionHeaderStyle}" Margin="0,0,0,10"/>

                <Border Style="{DynamicResource HistoryRowStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="NAME (REQUIRED)" Style="{DynamicResource SmallHeaderTextStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewMemberName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10"
                                 Background="{DynamicResource CardInnerSectionBackground}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderMuted}"
                                 Padding="8,6"/>

                        <TextBlock Text="NOTES" Style="{DynamicResource SmallHeaderTextStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewMemberNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10"
                                 Background="{DynamicResource CardInnerSectionBackground}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderMuted}"
                                 Padding="8,6"/>

                        <TextBlock Text="URL" Style="{DynamicResource SmallHeaderTextStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewMemberUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10"
                                 Background="{DynamicResource CardInnerSectionBackground}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderMuted}"
                                 Padding="8,6"/>

                        <Button Content="+ Add Member"
                                Command="{Binding AddMemberCommand}"
                                Style="{DynamicResource SecondaryActionButtonStyle}"
                                Foreground="{DynamicResource AccentPrimary}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderMuted}" Padding="0,15,0,0">
            <Button Command="{Binding GoBackCommand}" Style="{DynamicResource GhostActionButtonStyle}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Back to Library" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</UserControl>
